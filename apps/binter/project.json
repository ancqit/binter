{
  "name": "binter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/binter/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/binter",
        "index": "apps/binter/src/index.html",
        "browser": "apps/binter/src/main.ts",
        "tsConfig": "apps/binter/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/binter/public"
          }
        ],
        "styles": ["apps/binter/src/styles.css"]
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": true,
            "fonts": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 5173,
        "host": "127.0.0.1",
        "proxyConfig": "apps/binter/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "binter:build:production"
        },
        "development": {
          "buildTarget": "binter:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types --test apps/binter/src/app/flow.test.ts apps/binter/src/app/wake.test.ts"
      }
    }
  }
}
